<?xml version="1.0" encoding="utf-8"?>
<!-- Code block: horizontally scrollable code with a Copy button pinned top-right OUTSIDE the
     scroll region so it stays reachable while long lines pan. Wrapped in a vertical
     LinearLayout so an optional caption (the Mermaid fallback note) can sit BELOW the block. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- CodeScrollView: a HorizontalScrollView that can also wrap (M-134, set per bind). -->
        <com.pilcrowmd.rendering.CodeScrollView
            android:id="@+id/code_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <TextView
                android:id="@+id/code_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </com.pilcrowmd.rendering.CodeScrollView>

        <!-- Mermaid diagram (M-70): shown instead of code_scroll while a ```mermaid block is drawn
             on the device, and once it is; gone for normal code/yaml blocks. Fills the card width:
             the picture is drawn exactly the card's content width (crisp, no upscale blur), and
             shown at match_parent + fitCenter so it fills the width and grows tall (scrolls) rather
             than being capped/shrunk. minHeight is the empty panel shown while the render runs. -->
        <ImageView
            android:id="@+id/mermaid_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:minHeight="120dp"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:visibility="gone"
            android:contentDescription="Mermaid diagram" />

        <TextView
            android:id="@+id/code_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Copy"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- Mermaid fallback note. Shown (text + token color set in code) ONLY when a ```mermaid
         block is displayed as its source because the diagram could not be drawn; GONE for every
         other block and in the PDF export. Small + subtle. -->
    <TextView
        android:id="@+id/mermaid_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
