<?xml version="1.0" encoding="utf-8"?>
<!-- LaTeX block math: horizontally scrollable formula with label.
     Block math ($$ ... $$) may be wider than the screen, so it scrolls horizontally.
     The label "LaTeX" is optional per design, but improves clarity. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp">

    <HorizontalScrollView
        android:id="@+id/latex_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="horizontal">

        <TextView
            android:id="@+id/latex_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </HorizontalScrollView>
</FrameLayout>
