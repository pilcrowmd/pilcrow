<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Key for the view tag holding a TextView's unscaled base text size during a reader pinch
      (M-04). Android requires a resource id for keyed view tags. View-only: nothing here is
      rendered, so this file cannot affect layout or the visual goldens.
    -->
    <item name="pinch_base_text_size" type="id" />

    <!--
      Marks a TextView whose resting size does NOT come from the reader's font scale — chrome and
      the LaTeX formula. The pinch scaler skips these: it writes a PX size that only a
      fontScale-derived re-apply on bind can undo, and these views have no such re-apply, so
      scaling them leaves them permanently wrong at rest. See M-04 / M-105.
    -->
    <item name="pinch_excluded" type="id" />
    <!--
      The reader's DetailsState (M-161), on its RecyclerView, so a footnote jump — which only has the
      tapped view — can open the section it lands in, as the search and headings jumps do.
    -->
    <item name="details_state" type="id" />
    <!--
      M-159: the reader's AnchorTargets (heading anchor to block position), on its RecyclerView, so a
      `[text](#heading)` tap — which only has the tapped view — can find the heading it names.
    -->
    <item name="anchor_targets" type="id" />
    <!--
      M-93: what a tap on a relative-image placeholder does ("Tap to show"), on the reader's
      RecyclerView, so the span in a block's text reaches the screen without a global callback.
    -->
    <item name="image_tap_handler" type="id" />
    <!--
      The point of text under the fingers when a reader pinch began, on the reader's RecyclerView, so
      every frame of that gesture holds the same point under the fingers as they move.
    -->
    <item name="pinch_focal_anchor" type="id" />
    <!--
      The reader's jump-animation state (a footnote, #anchor or Contents jump in flight), on its
      RecyclerView, so a second jump can cancel the first without a global.
    -->
    <item name="reader_jump" type="id" />
    <!--
      Issue #15 / M-340: the DocumentId the hoisted editor's text belongs to, so a switch back from
      Read keeps that text (and its undo history, caret and scroll) instead of setting it again.
    -->
    <item name="editor_document" type="id" />
    <!--
      Issue #15: the landing reveal still watching the hoisted editor, so a newer one replaces it
      instead of the two moving the editor against each other.
    -->
    <item name="editor_reveal" type="id" />
    <!--
      M-160: what a tap on a link to another note does (a NoteLinkHandler), on the reader's
      RecyclerView, so the link span reaches the screen without a global callback.
    -->
    <item name="note_link_handler" type="id" />
</resources>
