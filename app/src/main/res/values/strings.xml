<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">PilcrowMD</string>
    <!-- Talkback label for the arrow on a footnote definition that returns to its first reference. -->
    <string name="footnote_back_link">Back to the footnote reference</string>
    <!-- TalkBack name of the editor's text box; the file name is appended after a comma (M-265). -->
    <string name="editor_accessibility_name">Markdown text</string>

    <!-- ===== Main screen, toolbar, formatting bar ===== -->
    <!-- Transient toast at the back press that arms exiting the app; a full sentence. -->
    <string name="main_press_back_again_to_exit">Press back again to exit</string>

    <!-- Status toast after a successful save. Adjective used as a status word. -->
    <string name="main_toast_saved">Saved</string>
    <!-- Status toast after a failed save. Full phrase, status label. -->
    <string name="main_toast_save_failed">Save failed</string>
    <!-- Status toast when a save is refused because the file is not UTF-8. Full sentence. -->
    <string name="main_toast_not_saved_not_utf8">Not saved: this file isn\'t UTF-8</string>
    <!-- Status toast when a copy is refused because the picked file already has content or is not UTF-8. Full sentence. -->
    <string name="main_toast_not_saved_pick_new_file">Not saved: pick a new file for the copy</string>
    <!-- Toast and welcome-screen message when a file fails to open. Full sentence. -->
    <string name="main_load_failed">Couldn\'t open that file</string>
    <!-- Status toast when a file is over the read limit (20 MiB). Full sentence. -->
    <string name="main_load_too_large">This file is too large to open.</string>
    <!-- Status toast after a successful PDF export. Past-tense adjective used as a status word. -->
    <string name="main_toast_exported">Exported</string>
    <!-- Status toast after a failed PDF export. Full phrase, status label. -->
    <string name="main_toast_export_failed">Export failed</string>

    <!-- Banner under the toolbar for a file that is not UTF-8. Two lines (\n); the second is a tappable call to action. -->
    <string name="main_banner_not_utf8">This file isn\'t UTF-8, so saving would change it.\nTap to Save a copy…</string>
    <!-- Banner under the toolbar for a file opened from another app with no write permission. Two lines (\n); the second is a tappable call to action. -->
    <string name="main_banner_transient">Temporary file opened from another app.\nTap to Save a copy…</string>

    <!-- Banner under the toolbar: the open file changed on another device just after it was opened, and there are no unsaved edits. One line (S8-A52); the whole banner is tappable. -->
    <string name="main_banner_changed">This file was just changed outside PilcrowMD. Tap to reload.</string>
    <!-- Banner under the toolbar: the open file changed on another device just after it was opened, while there are unsaved edits. Followed by the Reload and Keep mine buttons. Full sentence. -->
    <string name="main_banner_changed_edits">This file was just changed outside PilcrowMD.</string>
    <!-- Button on the "file changed" banner: read the file again. Short imperative. -->
    <string name="main_action_reload">Reload</string>
    <!-- Button on the "file changed" banner: keep the unsaved edits; saving will write them over the other version. Short phrase. -->
    <string name="main_action_keep_mine">Keep mine</string>
    <!-- Title of the dialog before reloading a changed file over unsaved edits. Question. -->
    <string name="main_dialog_reload_title">Reload the file?</string>
    <!-- Text of the dialog before reloading a changed file over unsaved edits. Full sentence. -->
    <string name="main_dialog_reload_text">Your unsaved edits will be lost.</string>
    <!-- Button of the reload dialog that keeps the edits and closes the dialog. Short imperative. -->
    <string name="main_dialog_reload_cancel">Cancel</string>

    <!-- Content description (TalkBack) of the button that closes the "temporary file" banner. Short imperative. -->
    <string name="main_banner_close">Close notice</string>

    <!-- Notice above the reader: the document is too big to format, so it shows as plain text. Full sentence. -->
    <string name="main_plain_notice_too_large">This document is too large to format on this device, so it is shown as plain text.</string>
    <!-- Notice above the reader: the document could not be formatted, so it shows as plain text. Full sentence. -->
    <string name="main_plain_notice_unrenderable">This document could not be formatted, so it is shown as plain text.</string>
    <!-- Notice in the editor slot: the file is too large to edit, so it stays in read mode. Full sentence. -->
    <string name="main_editor_too_large">This file is too large to edit here. You can still read and search it.</string>

    <!-- Bar under the toolbar, shown while recovered saves wait for the user. Tappable; opens the recovery dialog. %1$d is the count. -->
    <plurals name="main_recovered_files_to_save">
        <item quantity="one">%1$d recovered file to save — tap to resolve</item>
        <item quantity="other">%1$d recovered files to save — tap to resolve</item>
    </plurals>

    <!-- Title of the dialog that asks whether to save unsaved edits. Adjective phrase used as a heading. -->
    <string name="main_dialog_unsaved_title">Unsaved changes</string>
    <!-- Body of the dialog shown when closing a file with unsaved edits. Question sentence. -->
    <string name="main_dialog_unsaved_close_text">You have unsaved edits. Save before closing?</string>
    <!-- Body of the dialog shown when opening another file with unsaved edits. Question sentence. -->
    <string name="main_dialog_unsaved_open_text">Open the new file? Save your current edits first, or discard them.</string>

    <!-- Button in the unsaved-changes dialogs: save the edits. Verb, button label. -->
    <string name="main_action_save">Save</string>
    <!-- Button in the unsaved-changes and recovery dialogs: throw the edits away. Verb, button label. -->
    <string name="main_action_discard">Discard</string>
    <!-- Button in the recovery dialog: save one recovered file to a new location. Verb phrase, button label. -->
    <string name="main_action_save_a_copy">Save a copy</string>
    <!-- Button in the recovery dialog: dismiss the dialog. Verb, button label. -->
    <string name="main_action_close">Close</string>

    <!-- Pane name spoken by TalkBack when a document is shown in reading mode. Noun, a screen name. -->
    <string name="main_pane_reader">Reader</string>
    <!-- Pane name spoken by TalkBack when a document is shown in editing mode. Noun, a screen name. -->
    <string name="main_pane_editor">Editor</string>
    <!-- Pane title spoken by TalkBack: the mode, then the open file name. %1$s is Reader or Editor, %2$s is the file name. -->
    <string name="main_pane_title">%1$s, %2$s</string>
    <!-- The line above the text that names the open file, spoken by TalkBack. %1$s is the folder names ("Notes, projects"), %2$s the file name. -->
    <string name="main_open_file_description">File: %1$s, %2$s</string>
    <!-- Same, for a file that was not opened from My folders. %1$s is the file name. -->
    <string name="main_open_file_description_plain">File: %1$s</string>

    <!-- Toolbar overflow item: switch a .txt file to Markdown rendering. Menu item label. -->
    <string name="main_view_as_markdown">View as Markdown</string>
    <!-- Toolbar overflow item: switch a .md file to plain-text view. Menu item label. -->
    <string name="main_view_as_plain_text">View as plain text</string>

    <!-- Title of the dialog offering text the app kept from before it was ended. %1$s is the file name, e.g. "notes.md". -->
    <string name="main_draft_title">Unsaved changes in %1$s</string>
    <!-- Body of that dialog. %1$s is the time the text was kept, e.g. "14:32". Then what Restore does, and that the file itself is untouched. -->
    <string name="main_draft_text">PilcrowMD kept a copy of what you typed at %1$s. Restore puts it back in the editor. Your file stays as it is until you save.</string>
    <!-- Body of that dialog when the file was changed after the kept text was typed (for example by another app). %1$s is the time the text was kept, e.g. "14:32". -->
    <string name="main_draft_text_file_changed">This file changed after these edits were made at %1$s. Restore puts the kept text in the editor; your file stays as it is until you save. Or save the kept text as a copy.</string>
    <!-- Button on that dialog: put the kept text back in the editor. -->
    <string name="main_draft_restore">Restore</string>

    <!-- Title of the dialog listing unsaved files that could not be written to their own location. Adjective phrase used as a heading. -->
    <string name="main_recover_title">Recover unsaved files</string>
    <!-- Body of the recovery dialog. Two sentences, instructs the user to save a copy or discard. -->
    <string name="main_recover_text">These saves couldn\'t be written to their original location. Save a copy of each to keep it, or discard it.</string>
    <!-- Shown above the unsaved edits of files that can no longer be opened (deleted, moved) in the recovery dialog. Two sentences. -->
    <string name="main_recover_orphans_text">These unsaved edits were kept, but their files can no longer be opened. Save a copy of each to keep it, or discard it.</string>

    <!-- Toolbar button (top bar), opens the in-document search. Verb or noun, icon button TalkBack label. -->
    <string name="toolbar_search">Search</string>
    <!-- Toolbar button (top bar), opens the table of contents drawer. Noun phrase, icon button TalkBack label. -->
    <string name="toolbar_table_of_contents">Table of contents</string>
    <!-- Toolbar button (top bar, editing mode), saves the open file. Verb, icon button TalkBack label. -->
    <string name="toolbar_save">Save</string>
    <!-- Toolbar button (top bar) while a save is in progress. Gerund used as a state label. -->
    <string name="toolbar_saving">Saving</string>
    <!-- Toolbar button (top bar, editing mode), undoes the last edit. Verb, icon button TalkBack label. -->
    <string name="toolbar_undo">Undo</string>
    <!-- Toolbar button (top bar, editing mode), redoes the last undone edit. Verb, icon button TalkBack label. -->
    <string name="toolbar_redo">Redo</string>
    <!-- Toolbar button (top bar), closes the open file. Verb phrase, icon button TalkBack label. -->
    <string name="toolbar_close_file">Close file</string>
    <!-- Toolbar button (top bar, reading mode), exports the document as a PDF. Verb phrase, icon button TalkBack label. -->
    <string name="toolbar_export_pdf">Export PDF</string>
    <!-- Toolbar mode button, shown in editing mode: switches to reading mode. Verb, button label and long-press tooltip. -->
    <string name="toolbar_read">Read</string>
    <!-- Toolbar mode button, shown in reading mode: switches to editing mode. Verb, button label and long-press tooltip. -->
    <string name="toolbar_edit">Edit</string>
    <!-- Toolbar overflow button and its menu title. Noun phrase: the menu of extra actions. -->
    <string name="toolbar_more_actions">More actions</string>
    <!-- Toolbar overflow menu item: saves a copy of the open file to a new location. Verb phrase, menu item label. -->
    <string name="toolbar_save_a_copy">Save a copy</string>
    <!-- Toolbar overflow menu item, shown for a note with pictures in a folder not yet allowed. Menu item label. -->
    <string name="toolbar_show_folder_pictures">Show pictures from this folder</string>

    <!-- Formatting bar button: bold text. Adjective used as a button label. -->
    <string name="format_bold">Bold</string>
    <!-- Formatting bar button: italic text. Adjective used as a button label. -->
    <string name="format_italic">Italic</string>
    <!-- Formatting bar button: inserts a heading. Noun, button label. -->
    <string name="format_heading">Heading</string>
    <!-- Formatting bar button: inserts a bulleted list item. Noun phrase, button label. -->
    <string name="format_bulleted_list">Bulleted list</string>
    <!-- Formatting bar button: inserts a task checkbox. Noun, button label. -->
    <string name="format_checkbox">Checkbox</string>
    <!-- Formatting bar button: inserts a link. Noun, button label. -->
    <string name="format_link">Link</string>
    <!-- Formatting bar button, second row: inline code span. Noun phrase, button label. -->
    <string name="format_inline_code">Inline code</string>
    <!-- Formatting bar button, second row: inserts a block quote. Noun, button label. -->
    <string name="format_quote">Quote</string>
    <!-- Formatting bar button, second row: inserts a table. Noun, button label. -->
    <string name="format_table">Table</string>
    <!-- Formatting bar button, second row: strikes through text. Noun, button label. -->
    <string name="format_strikethrough">Strikethrough</string>
    <!-- Formatting bar button, second row: inserts a horizontal rule. Noun, button label. -->
    <string name="format_divider">Divider</string>
    <!-- Formatting bar button, second row: removes one indent level. Verb, button label. -->
    <string name="format_outdent">Outdent</string>
    <!-- Formatting bar button, second row: adds one indent level. Verb, button label. -->
    <string name="format_indent">Indent</string>
    <!-- Formatting bar button: undoes the last edit. Verb, button label. -->
    <string name="format_undo">Undo</string>
    <!-- Formatting bar button: redoes the last undone edit. Verb, button label. -->
    <string name="format_redo">Redo</string>
    <!-- Formatting bar button that opens or closes the second row of formatting buttons. Noun phrase, button label. -->
    <string name="format_more_formatting">More formatting</string>
    <!-- State spoken for the More formatting button while its second row is open. Adjective. -->
    <string name="format_state_expanded">Expanded</string>
    <!-- State spoken for the More formatting button while its second row is closed. Adjective. -->
    <string name="format_state_collapsed">Collapsed</string>

    <!-- The editor's TalkBack name when a file is open: the editor name, then the file name. %1$s is the editor name (Markdown text), %2$s is the file name. -->
    <string name="editor_accessibility_name_with_file">%1$s, %2$s</string>

    <!-- ===== Welcome screen, banners, search, headings, preview ===== -->
    <!-- Welcome screen (no document open). -->

    <!-- Progress line under the buttons while the last document is restored. -->
    <string name="welcome_loading_last_document">Opening your last document…</string>
    <!-- Line on the start screen when the last file was not reopened because the previous reopen never finished. Full sentence. -->
    <string name="welcome_last_file_not_reopened">Your last file was not reopened because it did not open cleanly.</string>
    <!-- Subtitle under the wordmark. -->
    <string name="welcome_tagline">Beautiful Markdown Reading</string>
    <!-- Primary button (verb phrase, imperative): opens the file picker for a Markdown file. -->
    <string name="welcome_open_file">Open MD File</string>
    <!-- Secondary button (verb phrase, imperative): creates a new, empty Markdown file. -->
    <string name="welcome_create_file">Create MD File</string>
    <!-- Low-emphasis link below the buttons: opens the file picker unfiltered. Imperative verb phrase at the end. -->
    <string name="welcome_browse_all_files">Can\'t see your file? Browse all files</string>
    <!-- Footer line under the divider; ".md" is a file extension and stays as written. -->
    <string name="welcome_supports_md">Supports .md files</string>
    <!-- Content description (spoken by TalkBack) of the gear icon that opens app Settings. Noun. -->
    <string name="welcome_settings_description">Settings</string>

    <!-- Confirm dialog for clearing the Recent list. -->
    <string name="welcome_clear_recents_title">Clear recent files?</string>
    <string name="welcome_clear_recents_message">This removes every entry from your Recent list. Your files are not deleted.</string>
    <!-- Confirm button (verb phrase, imperative): clears the whole Recent list. -->
    <string name="welcome_clear_recents_confirm">Clear all</string>
    <!-- Dismiss button (verb, imperative): closes the dialog without clearing. -->
    <string name="welcome_clear_recents_cancel">Cancel</string>

    <!-- One-time rating card, shown in the prompt slot on the welcome screen. -->
    <string name="welcome_rating_title">Enjoying PilcrowMD?</string>
    <!-- Card button (adverb phrase): dismisses the rating card for good. -->
    <string name="welcome_rating_not_now">Not now</string>
    <!-- Card button (verb phrase, imperative): opens the Play Store rating page. -->
    <string name="welcome_rating_rate">Rate on Play</string>

    <!-- Section header above the recent files list. All caps is intentional; a noun, not a verb. -->
    <string name="welcome_recent_header">RECENT</string>
    <!-- Button (verb, imperative) that clears every entry in the Recent list. Not the adjective "clear". -->
    <string name="welcome_recent_clear">Clear</string>
    <!-- Content description of the × on a recent-file row (verb phrase, imperative). -->
    <string name="welcome_recent_remove_description">Remove from recents</string>
    <!-- A recent row's subtitle: %1$s is how long ago it was opened (e.g. "5 minutes ago"). The suffix marks a file that can no longer be found. -->
    <string name="welcome_recent_unavailable">%1$s · unavailable</string>

    <!-- Update note (M-174), shown in the prompt slot. Store-neutral on purpose. -->
    <!-- Content description of the × on the update note (verb phrase, imperative): dismisses it for a while. -->
    <string name="update_note_dismiss_description">Dismiss update note</string>
    <string name="update_note_text">This version is over 2 months old. A newer one with fixes is probably available where you installed the app.</string>

    <!-- Image folder banner (M-93), under the toolbar. -->

    <!-- Title when a note has pictures in its folder. %1$d is the number of pictures; "one" and "other" are the singular and plural forms. -->
    <plurals name="banner_note_pictures_in_folder">
        <item quantity="one">This note has %1$d picture in its folder.</item>
        <item quantity="other">This note has %1$d pictures in its folder.</item>
    </plurals>
    <string name="banner_ask_folder_detail">Allow PilcrowMD to open the folder to show them.</string>
    <string name="banner_cannot_show_title">Pictures can\'t be shown from this folder.</string>
    <string name="banner_cannot_show_detail">Move the note and its pictures into a subfolder.</string>
    <!-- %1$s is the note's file name. -->
    <string name="banner_pick_folder_detail">Android did not say which folder that is. Pick the folder that holds %1$s to show them.</string>
    <!-- %1$s is the note's file name, e.g. "notes.md is not in that folder." -->
    <string name="banner_wrong_folder_title">%1$s is not in that folder.</string>
    <string name="banner_wrong_folder_detail">Pick the folder that holds it to show its pictures.</string>
    <!-- Button (verb phrase, imperative): asks for access to the note's folder. -->
    <string name="banner_allow_folder">Allow folder</string>
    <!-- Button (verb phrase, imperative): opens the folder picker for the note's folder. -->
    <string name="banner_pick_folder">Pick folder</string>
    <!-- Button (verb phrase, imperative): opens the folder picker again, after the wrong folder was chosen. -->
    <string name="banner_pick_again">Pick again</string>
    <!-- Button (adverb phrase): dismisses the banner without acting. -->
    <string name="banner_not_now">Not now</string>
    <!-- Button: acknowledges the banner that says pictures cannot be shown here. -->
    <string name="banner_ok">OK</string>

    <!-- In-document search bar (toolbar). -->
    <!-- Hint shown in the empty search field (noun). -->
    <string name="search_placeholder">Search</string>
    <!-- Match position, e.g. "3/12": %1$d is the 1-based current match, %2$d is the total. Numbers only, no words. -->
    <string name="search_match_count">%1$d/%2$d</string>
