    <string name="search_match_count_none">0/0</string>
    <!-- Content description of the arrow that moves to the previous match (adjective phrase). -->
    <string name="search_previous_match_description">Previous match</string>
    <!-- Content description of the arrow that moves to the next match (adjective phrase). -->
    <string name="search_next_match_description">Next match</string>
    <!-- Content description of the × that closes the search bar (verb phrase, imperative). -->
    <string name="search_close_description">Close search</string>

    <!-- Table of contents drawer. -->
    <!-- Drawer title (noun): the list of the document's headings. -->
    <string name="headings_title">Headings</string>

    <!-- Full-screen Mermaid diagram viewer. -->
    <!-- Content description of the diagram picture, read by TalkBack (noun phrase). -->
    <string name="diagram_content_description">Mermaid diagram, full screen</string>
    <!-- Content description of the × that closes the full-screen diagram (verb phrase, imperative). -->
    <string name="diagram_close_description">Close diagram</string>

    <!-- Reader scroll controls and the scroll position badge (Preview). -->
    <!-- Content description of the button that jumps to the top (verb phrase, imperative). -->
    <string name="preview_scroll_to_top_description">Scroll to top</string>
    <!-- Content description of the button that jumps to the bottom (verb phrase, imperative). -->
    <string name="preview_scroll_to_bottom_description">Scroll to bottom</string>
    <!-- Spoken by TalkBack after a jump to the top. Noun phrase. -->
    <string name="preview_landed_top">Top of document</string>
    <!-- Spoken by TalkBack after a jump to the bottom. Noun phrase. -->
    <string name="preview_landed_bottom">End of document</string>
    <!-- Scroll position badge: %1$d is how far through the document the reader is, as a whole percentage (e.g. "37%"). -->
    <string name="preview_scroll_percent">%1$d%%</string>

