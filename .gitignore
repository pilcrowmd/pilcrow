# Android / Gradle / Kotlin
*.iml
.gradle/
local.properties
.idea/
build/
# Kotlin 2.x persistent project state — a compiler session marker (`.kotlin/sessions/*.salive`)
# exists only WHILE a build runs, so a quiet `git status` shows nothing and the repo looks clean.
# Unignored, `git add -A` — a load-bearing step in docs/PUBLISHING.md — stages it, and the publish
# push is additive and unwithdrawable. It trips none of the 0-check classes, so nothing but reading
# the staged list by eye would catch it. See M-64.
.kotlin/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/

# Keystore / secrets
*.jks
*.keystore
keystore.properties
*.env
.env*

# OS / editor
.DS_Store
Thumbs.db

# Logs
*.log

# JVM heap dumps (e.g. Gradle daemon OOM)
*.hprof

# Local stress-test fixtures (large generated files; not part of the app)
StressTest/

# Generated audit bundle (regenerate via package_repo.py)
codebase_for_audit.txt

# Generated by com.jaredsburrows.license (copyJsonReportToAssets) — build artifact, not source.
# Regenerated on every build via mergeDebugAssets.dependsOn(licenseDebugReport).
app/src/main/assets/open_source_licenses.json
